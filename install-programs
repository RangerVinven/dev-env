#!/usr/bin/env bash

script_dir=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
filter=""
dry="0"

while [[ $# -gt 0 ]]; do
    if [[ $1 == "--dry" ]]; then
        dry="1"
    else
        filter="$1"
    fi
    shift
done

# ANSI color formatting (disabled if redirected or NO_COLOR is set)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    GREEN="\033[1;32m"
    RED="\033[1;31m"
    YELLOW="\033[1;33m"
    BLUE="\033[1;34m"
    BOLD="\033[1m"
    RESET="\033[0m"
else
    GREEN=""
    RED=""
    YELLOW=""
    BLUE=""
    BOLD=""
    RESET=""
fi

log() {
    if [[ $dry == "1" ]]; then
        echo -e "[DRY_RUN]: $@"
    else
        echo -e "$@"
    fi
}

cd "$script_dir"
scripts=$(find ./runs -maxdepth 1 -mindepth 1 -executable -type f | sort)

passed=()
failed=()

for script in $scripts; do
    script_name=$(basename "$script")
    if echo "$script_name" | grep -qv "$filter"; then
        continue
    fi

    echo ""
    log "${BLUE}${BOLD}===> Running: $script_name${RESET}"

    if [[ $dry == "1" ]]; then
        passed+=("$script_name")
        continue
    fi

    # Run the script and record result
    if "$script"; then
        passed+=("$script_name")
    else
        exit_code=$?
        failed+=("$script_name (exit code: $exit_code)")
    fi
done

# Final Summary Report
echo ""
echo "================================================================================"
echo -e "${BOLD}                           INSTALLATION SUMMARY${RESET}"
echo "================================================================================"

if [[ $dry == "1" ]]; then
    echo -e "${YELLOW}[DRY RUN] No commands were actually executed.${RESET}"
    echo ""
fi

if [ ${#passed[@]} -gt 0 ]; then
    echo -e "${GREEN}${BOLD}Successful (${#passed[@]}):${RESET}"
    for item in "${passed[@]}"; do
        echo -e "  ${GREEN}✓${RESET} $item"
    done
    echo ""
fi

if [ ${#failed[@]} -gt 0 ]; then
    echo -e "${RED}${BOLD}Failed (${#failed[@]}):${RESET}"
    for item in "${failed[@]}"; do
        echo -e "  ${RED}✗${RESET} $item"
    done
    echo ""
    echo -e "${YELLOW}To investigate or retry any failed installation individually, run:${RESET}"
    for item in "${failed[@]}"; do
        name="${item%% *}"
        echo "  ./install-programs $name"
    done
    echo "================================================================================"
    exit 1
else
    echo -e "${GREEN}${BOLD}All executed installations completed successfully!${RESET}"
    echo "================================================================================"
fi


