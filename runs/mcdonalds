#!/usr/bin/env bash

# Ensure Python, pip, and cron service are installed
sudo dnf install -y python3 python3-pip cronie
sudo systemctl enable --now crond 2>/dev/null || true

TARGET_DIR="$HOME/Documents/Projects/Python/McDonalds-Form-Submitter"
mkdir -p "$(dirname "$TARGET_DIR")"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Cloning McDonalds-Survey-Submitter..."
    if ! git clone https://github.com/RangerVinven/McDonalds-Survey-Submitter.git "$TARGET_DIR"; then
        echo "ERROR: Failed to clone RangerVinven/McDonalds-Survey-Submitter."
        echo "Because this is a private repository, please authenticate with GitHub (via ghswitch, SSH key, or ~/.git-credentials) and re-run this script."
        exit 1
    fi
fi

cd "$TARGET_DIR"
python3 -m venv venv
./venv/bin/pip install --upgrade pip
./venv/bin/pip install -r requirements.txt
./venv/bin/playwright install chromium

# Avoid duplicate crontab entries if script is run multiple times
CRON_CMD="@reboot sleep 60 && cd $TARGET_DIR && DISPLAY=:0 $TARGET_DIR/venv/bin/python3 -u worker.py >> worker.log 2>&1"
(crontab -l 2>/dev/null | grep -Fv "worker.py"; echo "$CRON_CMD") | crontab -

if [ ! -f "$TARGET_DIR/service_account.json" ]; then
    echo "NOTE: Remember to place your Google Cloud 'service_account.json' into $TARGET_DIR for Google Sheets access."
fi

