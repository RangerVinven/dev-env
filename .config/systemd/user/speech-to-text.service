[Unit]
Description=Speech-To-Text Main Application
After=network.target sound.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/daniel/.Xauthority
WorkingDirectory=/home/daniel/Documents/Projects/Speech-To-Text
ExecStart=/home/daniel/Documents/Projects/Speech-To-Text/venv/bin/python /home/daniel/Documents/Projects/Speech-To-Text/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
